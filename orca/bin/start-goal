#!/usr/bin/env bash
# start-goal — Start one autopilot goal in its own Orca worktree and session.
#
# Usage:
#   orca/bin/start-goal [--name <name>] [--profile <profile>] <repo> "<goal>"
#
#   <repo>   a Git checkout registered in Orca (`orca repo add --path <repo>`).
#   <goal>   the goal text, passed to the session as `/my:autopilot <goal>`.
#   --name   Orca worktree name (default goal-<YYYYmmdd-HHMMSS>). Orca adds a
#            numeric suffix when the name is taken.
#   --profile  orca/profiles/<profile>.conf for this goal only, in place of
#            $MY_ORCA_PROFILE and the machine's orca.conf.
#
# Steps, in this order:
#   1. Create an Orca worktree of <repo> from origin's default branch
#      (refs/remotes/origin/HEAD).
#   2. Merge the deny rules of orca/settings/goal.deny.json into the worktree's
#      .claude/settings.local.json, keeping what is already there, add that file
#      to the repository's info/exclude unless Git already ignores it, and mark
#      the worktree for autopilot in its Git dir (my-autopilot-worktree).
#      For Antigravity, which has no settings file per workspace, also register
#      scripts/hooks/antigravity-goal-deny.sh, which applies the same deny
#      rules, in the worktree's .agents/hooks.json (keeping the hooks already
#      there) and exclude that file the same way, or mark it skip-worktree
#      when the repository tracks it, so the run never commits it.
#   3. Launch the profile's `implement <harness> <model>` agent in the worktree
#      as a terminal session with the prompt `/my:autopilot <goal>`. The harness
#      must be claude or antigravity.
#   4. Wait about two minutes, and at least 30 seconds after the agent is up,
#      for the prompt to start a turn (the agent shows in `orca agent list` with
#      the prompt as its title). When Claude Code is idle with no title and the
#      prompt is not in its input box, send the prompt once with
#      `orca terminal send`. Antigravity's input box is not read, so its prompt
#      is never resent: that case exits 3 with the recovery command.
# When step 2 or 3 fails, the worktree is removed again. When step 4 fails,
# the worktree and the session are kept and stderr names the terminal handle
# and the command that sends the prompt by hand.
#
# The profile is --profile, else $MY_ORCA_PROFILE, else `profile <name>` in
# ~/.claude/my-toolkit/orca.conf; it names orca/profiles/<name>.conf.
#
# Exit codes:
#   0  the agent was launched in the new worktree and its prompt started a turn
#   2  usage or configuration error (arguments, repo, profile, an implement
#      harness other than claude or antigravity, deny file, repo not
#      registered in Orca, existing local settings that are not an object with
#      a deny array, an existing .agents/hooks.json that is not an object, or
#      for antigravity a missing scripts/hooks/antigravity-goal-deny.sh)
#   3  Orca unusable: no orca command, runtime unreachable, Orca failed to
#      create the worktree or launch the agent, or no turn was seen to start
#      (the worktree is kept only in this last case)
# The last line on stdout is `[start-goal] exit=<n> <worktree path or ->`.
#
# Environment: MY_ORCA_PROFILE.
# Dependencies: bash, jq, git, awk.
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
DENY_FILE="$ROOT/orca/settings/goal.deny.json"
AGY_DENY_HOOK="$ROOT/scripts/hooks/antigravity-goal-deny.sh"
MARKER=my-autopilot-worktree
WT="-"

usage() {
  sed -n '2,/^# Dependencies/s/^# \{0,1\}//p' "$0"
}

finish() {
  printf '[start-goal] exit=%s %s\n' "$1" "$WT"
  exit "$1"
}

die() {
  local code="$1"
  shift
  printf 'start-goal: %s\n' "$*" >&2
  finish "$code"
}

# discard_worktree CODE MESSAGE — remove the worktree made in step 1, then die.
discard_worktree() {
  orca terminal close --worktree "path:$WT" --all --json >/dev/null 2>&1
  orca worktree rm --worktree "path:$WT" --force --delete-branch --json >/dev/null 2>&1 \
    || printf 'start-goal: could not remove %s; remove it with orca worktree rm\n' "$WT" >&2
  die "$@"
}

name=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --name)
      [ $# -ge 2 ] && [ -n "$2" ] || die 2 "--name needs a value"
      name="$2"
      shift 2 ;;
    --profile)
      [ $# -ge 2 ] && [ -n "$2" ] || die 2 "--profile needs a value"
      export MY_ORCA_PROFILE="$2"
      shift 2 ;;
    --) shift; break ;;
    -*) die 2 "unknown option: $1" ;;
    *) break ;;
  esac
done
[ $# -eq 2 ] || die 2 "usage: start-goal [--name <name>] [--profile <profile>] <repo> \"<goal>\""
goal="$2"
[ -n "$goal" ] || die 2 "the goal is empty"
command -v jq >/dev/null 2>&1 || die 2 "jq is required"
repo="$(git -C "$1" rev-parse --show-toplevel 2>/dev/null)" || die 2 "not a Git checkout: $1"
base="$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)" \
  || die 2 "no default branch for origin in $repo (run: git -C $repo remote set-head origin --auto)"
[ -n "$name" ] || name="goal-$(date +%Y%m%d-%H%M%S)"

jq -e '.permissions.deny | type == "array" and length > 0' "$DENY_FILE" >/dev/null 2>&1 \
  || die 2 "no deny rules in $DENY_FILE"

# shellcheck source=../lib/profile.sh
. "$ROOT/orca/lib/profile.sh"
profile="$(orca_profile_name)"
[ -n "$profile" ] || die 2 "no profile: set MY_ORCA_PROFILE or write 'profile <name>' in $ORCA_CONF ($(orca_profile_choices))"
profile_file="$(orca_profile_file "$profile")" || die 2 "no profile named '$profile' ($(orca_profile_choices))"
harness="" model=""
while read -r r h m _ || [ -n "$r" ]; do
  if [ "$r" = implement ]; then harness="$h"; model="$m"; break; fi
done < "$profile_file"
[ -n "$harness" ] && [ -n "$model" ] || die 2 "profile $profile has no 'implement <harness> <model>' line"
case "$harness" in
  claude|antigravity) ;;
  *) die 2 "profile $profile runs implement on $harness; start-goal needs claude or antigravity" ;;
esac
if [ "$harness" = antigravity ]; then
  [ -x "$AGY_DENY_HOOK" ] || die 2 "the goal deny hook is missing or not executable: $AGY_DENY_HOOK"
fi

command -v orca >/dev/null 2>&1 || die 3 "orca command not found on PATH"
status_json="$(orca status --json 2>/dev/null)"
[ "$(printf '%s' "$status_json" | jq -r '(.ok == true) and (.result.runtime.reachable == true)' 2>/dev/null)" = true ] \
  || die 3 "Orca runtime not reachable (orca status --json)"

created="$(orca worktree create --repo "path:$repo" --name "$name" --no-parent \
  --base-branch "$base" --json 2>/dev/null)"
path="$(printf '%s' "$created" | jq -r '.result.worktree.path // empty' 2>/dev/null)"
if [ -z "$path" ]; then
  printf '%s\n' "$created" >&2
  if [ "$(printf '%s' "$created" | jq -r '.error.code // empty' 2>/dev/null)" = repo_not_found ]; then
    die 2 "$repo is not registered in Orca (run: orca repo add --path $repo)"
  fi
  die 3 "orca worktree create failed for $repo"
fi
WT="$path"
[ -d "$WT" ] || discard_worktree 3 "Orca reported a worktree that does not exist: $WT"

settings="$WT/.claude/settings.local.json"
current='{}'
if [ -f "$settings" ]; then
  jq -e 'type == "object" and ((.permissions // {}) | type == "object")
    and ((.permissions.deny // []) | type == "array")' "$settings" >/dev/null 2>&1 \
    || discard_worktree 2 "existing $settings is not a JSON object with a deny array; not overwriting it"
  current="$(cat "$settings")"
fi
mkdir -p "$WT/.claude" || discard_worktree 3 "cannot create $WT/.claude"
printf '%s' "$current" | jq --slurpfile add "$DENY_FILE" '
  (.permissions.deny // []) as $have
  | .permissions = ((.permissions // {}) + {deny: ($have + ($add[0].permissions.deny - $have))})
' >"$settings.tmp" && mv "$settings.tmp" "$settings" \
  || discard_worktree 3 "cannot write $settings"
if [ "$harness" = antigravity ]; then
  hooks="$WT/.agents/hooks.json"
  current='{}'
  if [ -f "$hooks" ]; then
    jq -e 'type == "object"' "$hooks" >/dev/null 2>&1 \
      || discard_worktree 2 "existing $hooks is not a JSON object; not overwriting it"
    current="$(cat "$hooks")"
  fi
  mkdir -p "$WT/.agents" || discard_worktree 3 "cannot create $WT/.agents"
  printf '%s' "$current" | jq --arg cmd "$AGY_DENY_HOOK" '
    .["goal-deny"] = {PreToolUse: [{matcher: "*", hooks: [{type: "command", command: $cmd, timeout: 10}]}]}
  ' >"$hooks.tmp" && mv "$hooks.tmp" "$hooks" \
    || discard_worktree 3 "cannot write $hooks"
fi
git_dir="$(git -C "$WT" rev-parse --absolute-git-dir 2>/dev/null)" \
  || discard_worktree 3 "not a Git worktree: $WT"
for local_file in .claude/settings.local.json .agents/hooks.json; do
  [ -f "$WT/$local_file" ] || continue
  git -C "$WT" check-ignore -q "$local_file" && continue
  if git -C "$WT" ls-files --error-unmatch "$local_file" >/dev/null 2>&1; then
    git -C "$WT" update-index --skip-worktree "$local_file" \
      || discard_worktree 3 "cannot hide the change to the tracked $local_file"
    continue
  fi
  exclude="$(git -C "$WT" rev-parse --path-format=absolute --git-path info/exclude)"
  mkdir -p "${exclude%/*}" && printf '/%s\n' "$local_file" >>"$exclude" \
    || discard_worktree 3 "cannot write $exclude"
done
printf '%s\n' "$goal" >"$git_dir/$MARKER" || discard_worktree 3 "cannot write $git_dir/$MARKER"

# turn_state — "started" when an agent in the worktree has a title (its first
# prompt) or is past "done" (a prompt sent later leaves the title empty), "idle"
# when one is listed otherwise, "none" when none is.
turn_state() {
  orca agent list --worktree "path:$WT" --json 2>/dev/null | jq -r '
    [.result.agents[]?] as $a
    | if any($a[]; .title != null or .state != "done") then "started"
      elif ($a | length) > 0 then "idle" else "none" end' 2>/dev/null
}

# resendable — true when the agent is Claude Code, its input box (a ❯ line
# between two rules) is on screen, does not hold the prompt, and no turn has
# started.
resendable() {
  [ "$harness" = claude ] || return 1
  [ "$(turn_state)" = idle ] || return 1
  orca terminal read --terminal "$handle" --screen --json 2>/dev/null \
    | jq -r '.result.terminal.tail[]?' 2>/dev/null \
    | awk '/^(─)+$/ { if (box) found = 1; box = 0; rule = 1; next }
           rule && /^❯/ { box = !index($0, "/my:autopilot"); rule = 0; next }
           { rule = 0; box = 0 }
           END { exit !found }'
}

# stuck MESSAGE — keep the worktree and its session, print how to recover, exit 3.
stuck() {
  printf 'start-goal: %s\n' "$1" >&2
  printf 'start-goal: the session is %s in %s; check it with: orca terminal read --terminal %s --screen\n' \
    "$handle" "$WT" "$handle" >&2
  local sq="'"
  printf 'start-goal: once the screen shows no turn, send the prompt by hand with: orca terminal send --terminal %s --enter --wait-submit %s --text %s\n' \
    "$handle" "$wait_submit" "$sq${prompt//$sq/$sq\\$sq$sq}$sq" >&2
  finish 3
}

prompt="/my:autopilot $goal"
wait_submit=30
launched="$(orca agent launch --agent "$harness" --worktree "path:$WT" --model "$model" \
  --surface terminal --prompt "$prompt" --json 2>/dev/null)"
handle="$(printf '%s' "$launched" | jq -r 'select(.ok == true) | .result.outcome.handle // empty' 2>/dev/null)"
if [ -z "$handle" ]; then
  printf '%s\n' "$launched" >&2
  discard_worktree 3 "orca agent launch failed ($harness, $model)"
fi
printf 'start-goal: %s (%s, %s, profile %s) in %s\n' "$handle" "$harness" "$model" "$profile" "$WT" >&2

tries=0 idle=0
while state="$(turn_state)"; [ "$state" != started ]; do
  case "$state" in idle) idle=$((idle + 1)) ;; *) idle=0 ;; esac
  tries=$((tries + 1))
  if [ "$tries" -ge 24 ] && { [ "$state" != idle ] || [ "$idle" -ge 6 ]; }; then break; fi
  sleep 5
done
[ "$state" = started ] && finish 0
[ "$state" = idle ] \
  || stuck "the agent did not report to Orca within two minutes, so the turn could not be checked; the launch prompt may still arrive, and nothing was resent"
resendable && sleep 5 && resendable \
  || stuck "the prompt started no turn, and the agent's input box was not seen empty of it; nothing was resent"
sent="$(orca terminal send --terminal "$handle" --enter --wait-submit "$wait_submit" --text "$prompt" --json 2>/dev/null)"
if printf '%s' "$sent" | jq -e '.result.send.prompt.stages | index("turn_started")' >/dev/null 2>&1 \
  || [ "$(turn_state)" = started ]; then
  printf 'start-goal: the prompt was resent and started a turn\n' >&2
  finish 0
fi
stuck "the resent prompt did not start a turn either"
